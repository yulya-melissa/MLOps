# Скопировать в .env:  Copy-Item .env.example .env
# .env в .gitignore — в репозиторий не попадает.

# --- Уровень логирования всех сервисов конвейера ---
FIRE_LOG_LEVEL=INFO

# --- Версии образов наблюдаемости (тег latest запрещён) ---
LOKI_VERSION=3.7.0
ALLOY_VERSION=v1.21.3

# --- Настройки агента логов ---
# Значение label com.docker.compose.project (проверить: docker inspect fire_detection_app)
COMPOSE_PROJECT=mlops
# Лейбл env в Loki. Должен совпадать с FIRE_ENVIRONMENT сервисов.
LOG_ENV=production

# --- Grafana (раздел 4, подключает Юля) ---
GRAFANA_VERSION=11.6.0
GF_SECURITY_ADMIN_PASSWORD=change-me

# --- OpenTelemetry (раздел 2) ---
# По умолчанию выключено: приложение обязано работать без Collector.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLER=parentbased_always_on